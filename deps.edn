{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        org.clojure/data.json {:mvn/version "2.5.0"}
        http-kit/http-kit {:mvn/version "2.8.1"}}
 :aliases
 {:test {:extra-paths ["test"]
         :main-opts ["-m" "mcp.test-runner"]}
  :time-server {:main-opts ["-m" "mcp.time-server"]}
  :deploy {:replace-deps {slipset/deps-deploy {:mvn/version "0.2.2"}}
           :exec-fn deps-deploy.deps-deploy/deploy
           :exec-args {:installer :remote
                       :artifact "org.clojars.pooriayousefi/mcp.clj"
                       :version "1.0.1"
                       :sign-releases? false}}}}
