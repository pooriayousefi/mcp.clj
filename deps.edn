{:deps {org.clojure/clojure {:mvn/version "1.12.6"}
        org.clojure/data.json {:mvn/version "2.5.0"}
        clj-http/clj-http {:mvn/version "3.13.0"}}
 :paths ["src" "test"]
 :aliases {:repl {:extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}
                               cider/cider-nrepl {:mvn/version "0.47.0"}}}
           :time-server {:main-opts ["-m" "time-server.core"]}
           :deploy {:replace-deps {slipset/deps-deploy {:mvn/version "0.2.2"}} 
                    :exec-fn deps-deploy.deps-deploy/deploy 
                    :exec-args {:installer :remote 
                                :artifact "org.clojars.pooriayousefi/mcp.clj" 
                                :version "0.1.1"
                                :sign-releases? false}}}}